# These are configuration examples, not credentials. Set shell/CI variables.
BASE_URL=http://localhost:3000
API_URL=http://localhost:8080/api/v1/
TARGET_ENV=local
# Exact origin of every permitted host, comma separated; no wildcards.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
BUSINESS_ID=
BRANCH_ID=
API_TOKEN=
# Authenticated browser checks are a later extension; never commit storage state.
# Write suite additionally requires all three variables below:
ALLOW_WRITES=false
DISPOSABLE_BUSINESS_ID=
CASH_METHOD_ID=

# Onboarding browser test: use a fresh account that has not completed setup.
ONBOARDING_ACCOUNT_DISPOSABLE=false
# Keep false unless a fresh production account is explicitly approved for onboarding.
ALLOW_PRODUCTION_ONBOARDING=false
ONBOARDING_EMAIL=
ONBOARDING_PASSWORD=
ONBOARDING_PLAN=Lifetime License
ONBOARDING_COMPANY_NAME=Nexstock QA Company
ONBOARDING_INDUSTRY=Distribution
ONBOARDING_WEBSITE=https://example.invalid
ONBOARDING_COMPANY_EMAIL=qa@example.invalid
ONBOARDING_PHONE=51234567
ONBOARDING_STREET_ADDRESS=12 Cyber City
ONBOARDING_CITY=Ebene
ONBOARDING_POSTAL_CODE=72201
ONBOARDING_LANGUAGE=English (English)
ONBOARDING_BRN=
ONBOARDING_BRN_PROOF_PATH=
ONBOARDING_VAT_REGISTERED=false

# Products & Catalog UI tests. Use a disposable account/business.
PRODUCT_TEST_ACCOUNT_DISPOSABLE=false
ALLOW_PRODUCTION_PRODUCT_TESTS=false
PRODUCT_TEST_EMAIL=
PRODUCT_TEST_PASSWORD=
PRODUCT_TEST_COMPANY=Nexstock QA Company
PRODUCT_TEST_CATEGORY=QA Automation
PRODUCT_TEST_UNIT=Piece
PRODUCT_TEST_UNIT_ABBREVIATION=pcs

# Stores & Branches UI tests. Uses the same disposable authenticated account.
STORE_TEST_COMPANY=Nexstock QA Company
STORE_TEST_PHONE=51234567
STORE_TEST_EMAIL_DOMAIN=example.invalid
STORE_TEST_ADDRESS=12 Cyber City, Ebene

# Stock Adjustments: same disposable QA account and explicit mutation opt-ins.
ADJUSTMENT_TEST_COMPANY=Nexstock QA Company
ADJUSTMENT_TEST_ACTOR=Fuad Peerbocus
# Optional: select a QA-prefixed branch/product visible in the Stores matrix.
ADJUSTMENT_TEST_BRANCH=
ADJUSTMENT_TEST_SKU=

# POS & Checkout: uses the same disposable QA company/account and mutation guards.
POS_TEST_COMPANY=Nexstock QA Company
# Optional QA-prefixed simple product. Defaults to a QA-ADD product.
POS_TEST_SKU=
# Optional QA branch. Defaults to the adjustment form's selected branch.
POS_TEST_BRANCH=

# Invoicing: same disposable QA account and production mutation guards.
INVOICE_TEST_COMPANY=Nexstock QA Company
# Optional QA-prefixed simple product and branch visible in Stores matrix.
INVOICE_TEST_SKU=
INVOICE_TEST_BRANCH=
# Optional Python interpreter with pypdf for invoice PDF content checks.
# Defaults to Codex bundled Python when available, otherwise python on PATH.
PDF_PYTHON=

# Suppliers: same disposable QA account and explicit production mutation guards.
SUPPLIER_TEST_COMPANY=Nexstock QA Company

# Customers & AR: same disposable QA account and explicit mutation guards.
CUSTOMER_TEST_COMPANY=Nexstock QA Company
# Optional independently verified, synthetic QA ledger for read-only AR checks.
# Missing fixture fails normally as TEST DATA BLOCKER, never intentionally skips.
CUSTOMER_AR_SEED_PATH=

# Security: reuses the existing disposable QA credentials and production guard.
SECURITY_TEST_COMPANY=Nexstock QA Company
# User confirmed: 30 minutes inactive => PIN lock, not logout.
# Override only to match a user-confirmed saved setting. No automatic policy edits.
SECURITY_IDLE_TIMEOUT_MINUTES=30
# Set true only after a human has provisioned the account PIN. Never store PIN here.
SECURITY_PIN_PROVISIONED=false
# client = bounded client-clock simulation; wall = actual elapsed-time run.
# Client-clock results do NOT certify server-side idle expiry.
SECURITY_IDLE_CLOCK=client
# Optional deployment-matched independent backend audit record (no hashes/secrets).
SECURITY_BCRYPT_AUDIT_PATH=
# Human-only credential workflow: keep false for normal unattended executions.
# Never use PRODUCT_TEST_EMAIL for a password rotation.
SECURITY_INTERACTIVE_HANDOFF=false
SECURITY_HANDOFF_EMAIL=

# Hardware: same disposable company/account. Read-only business requests;
# carts and paper-width selections are unsaved. Never completes a sale or prints paper.
HARDWARE_TEST_COMPANY=Nexstock QA Company
# Optional enabled QA-prefixed product with persisted leading-zero barcode and stock >= 3.
# Defaults to first enabled QA POS tile; customization uses Standard / no add-ons.
HARDWARE_TEST_SKU=
# Existing synthetic completed-sale receipt approved for read-only reprint.
HARDWARE_RECEIPT_REFERENCE=
# Independent real printer/scanner acceptance evidence, never illustrative values.
# Keep outside test-results (cleared by runs), in a private ignored location.
HARDWARE_ACCEPTANCE_PATH=

# Settings: reuses disposable QA credentials and explicit production/write opt-ins.
# Run serially, without concurrent users/suites editing the same QA settings.
# Private recovery baseline: playwright/.auth/settings-baseline.json.
# A pending baseline must match again (developer recovery) before new mutations.
SETTINGS_TEST_COMPANY=Nexstock QA Company

# Help Center, Legal & Compliance: same disposable account; no business writes.
# Only routine own-session authentication/selection/logout is permitted.
# Approved legal-document and release-record comparisons are deferred by user.
HELP_TEST_COMPANY=Nexstock QA Company
